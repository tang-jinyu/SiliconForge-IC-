# Copy this file to .env.server on the Linux server. Never commit the result.
DIGITAL_IC_AGENT_ENV_PROFILE=server
# Keep the host port local when Cloudflare Tunnel is enabled.
DIGITAL_IC_AGENT_BIND_ADDRESS=127.0.0.1
DIGITAL_IC_AGENT_PORT=8000
DIGITAL_IC_AGENT_ACCESS_PASSWORD=change-me-before-exposing-the-port
DIGITAL_IC_AGENT_SESSION_SECRET=replace-with-a-long-random-value
# Public deployments require each logged-in user to provide their own model key.
DIGITAL_IC_AGENT_ALLOW_SHARED_LLM=false
DIGITAL_IC_AGENT_LLM_TIMEOUT_SECONDS=600
DIGITAL_IC_AGENT_LLM_MAX_ATTEMPTS=3
DIGITAL_IC_AGENT_LLM_RETRY_BACKOFF_SECONDS=2
# Keep this a StepFun model when the remote StepFun route is enabled.
# DIGITAL_IC_AGENT_LLM_FALLBACK_MODEL=step-3.5-flash
DIGITAL_IC_AGENT_SIM_TIMEOUT_SECONDS=120
DIGITAL_IC_AGENT_SYNTH_TIMEOUT_SECONDS=300

# Remote StepFun mode: uncomment and fill these four values.
# DIGITAL_IC_AGENT_API_KEY=
# DIGITAL_IC_AGENT_BASE_URL=https://api.stepfun.com/v1
# DIGITAL_IC_AGENT_MODEL=step-5-preview
# DIGITAL_IC_AGENT_LLM_TRANSPORT=chat

# H100 mode is supplied by compose.h100.yaml. Optional model settings:
VLLM_MODEL=Qwen/Qwen3-32B-AWQ
VLLM_TENSOR_PARALLEL_SIZE=2
VLLM_MAX_MODEL_LEN=32768
VLLM_API_KEY=local-h100
HF_CACHE_DIR=./model-cache
HUGGING_FACE_HUB_TOKEN=

# Cloudflare Zero Trust -> Networks -> Tunnels -> Add a replica.
# Keep the real token only in .env.server; never commit it.
CLOUDFLARE_TUNNEL_TOKEN=
